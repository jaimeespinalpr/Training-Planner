rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function coach() { return signedIn() && request.auth.token.role == 'coach'; }
    match /training_plans/{planId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.assignedUids);
      allow create, update, delete: if coach() && request.resource.data.ownerUid == request.auth.uid;
    }
    match /training_templates/{templateId} {
      allow read: if signedIn();
      allow write: if coach() && request.resource.data.ownerUid == request.auth.uid;
    }
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if signedIn() && request.auth.uid == uid; }
    match /{document=**} { allow read, write: if false; }
  }
}